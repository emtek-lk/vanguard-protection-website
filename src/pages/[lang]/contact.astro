---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import { ui } from '../../data/ui';
import { bgUrl } from '../../lib/assets';
import { locales, tx, type Lang } from '../../lib/i18n';
import { site } from '../../lib/site';

export const getStaticPaths = () => locales.map((lang) => ({ params: { lang }, props: { lang } }));
const { lang } = Astro.props as { lang: Lang };
const c = ui.contact;
const hero = await bgUrl('images/services/cleaning-atrium-trolley.webp');
---
<Base lang={lang} title={tx(c.title, lang)} description={tx(c.lead, lang)}>
  <section class="hero" style={`--hero-img:url(${hero})`}>
    <div class="container">
      <span class="eyebrow">Vanguard Protection (Pvt) Ltd</span>
      <h1>{tx(c.title, lang)}</h1>
      <p class="lead">{tx(c.lead, lang)}</p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div>
        <h2>{tx(c.details, lang)}</h2>
        <ul class="info-list">
          <li>
            <span class="ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
            <div><strong>{tx(c.address, lang)}</strong><span class="v">{site.addressLines.join(', ')}</span></div>
          </li>
          <li>
            <span class="ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg></span>
            <div><strong>{tx(c.phone, lang)}</strong><a href={site.phoneHref}>{site.phone}</a></div>
          </li>
          <li>
            <span class="ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span>
            <div><strong>{tx(c.email, lang)}</strong><a href={`mailto:${site.email}`}>{site.email}</a></div>
          </li>
        </ul>
        <a class="btn btn-outline" href={site.whatsappHref} target="_blank" rel="noopener">{tx(c.whatsapp, lang)}</a>
        <div class="map" style="margin-top:1.8rem">
          <iframe src={site.mapEmbed} title="Map" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <p style="margin-top:.8rem"><a href={site.mapLink} target="_blank" rel="noopener">{tx(c.openMap, lang)} →</a></p>
      </div>
      <div>
        <h2>{tx(c.formTitle, lang)}</h2>
        <ContactForm lang={lang} />
      </div>
    </div>
  </section>
</Base>
