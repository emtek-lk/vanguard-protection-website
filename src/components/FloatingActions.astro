---
import { site } from '../lib/site';
---
<div class="progress" id="progress" aria-hidden="true"></div>
<div class="fab">
  <button class="up" id="to-top" aria-label="Back to top" type="button">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 15 6-6 6 6" /></svg>
  </button>
  <a class="wa" href={site.whatsappHref} target="_blank" rel="noopener" aria-label="WhatsApp">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M20.5 3.5A11.8 11.8 0 0 0 12 0C5.4 0 .1 5.3.1 11.9c0 2.1.5 4.1 1.6 5.9L0 24l6.4-1.7a11.9 11.9 0 0 0 5.6 1.4c6.6 0 11.9-5.3 11.9-11.9 0-3.2-1.2-6.2-3.4-8.3zM12 21.7a9.9 9.9 0 0 1-5-1.4l-.4-.2-3.8 1 1-3.7-.2-.4A9.9 9.9 0 1 1 12 21.7zm5.4-7.4c-.3-.1-1.8-.9-2-1s-.5-.1-.7.1-.8 1-1 1.2-.4.2-.7.1a8.1 8.1 0 0 1-4-3.5c-.3-.5.3-.5.9-1.6.1-.2.1-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6a1.2 1.2 0 0 0-.9.4 3.7 3.7 0 0 0-1.1 2.7 6.4 6.4 0 0 0 1.4 3.4 14.6 14.6 0 0 0 5.6 4.9c2 .8 2.8.9 3.8.7a3.2 3.2 0 0 0 2.1-1.5 2.6 2.6 0 0 0 .2-1.5c-.1-.1-.3-.2-.6-.3z" /></svg>
  </a>
</div>
<script>
  const root = document.documentElement;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── scroll progress, sticky header state, back-to-top ──
  const bar = document.getElementById('progress')!;
  const header = document.querySelector('.site-header');
  const up = document.getElementById('to-top')!;
  let ticking = false;
  const onScroll = () => {
    const y = scrollY;
    const max = root.scrollHeight - innerHeight;
    bar.style.transform = `scaleX(${max > 0 ? Math.min(1, y / max) : 0})`;
    header?.classList.toggle('scrolled', y > 10);
    up.classList.toggle('show', y > 600);
    ticking = false;
  };
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });
  onScroll();
  up.addEventListener('click', () => scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' }));

  // ── reveal on scroll ──
  const targets = document.querySelectorAll<HTMLElement>(
    '.section-head, .split > *, .division-card, .card, .service-card, .step, .post-card, .band, .leader, .stat, .chips li, .principle, .highlight, .chain span, .info-list li, .form, .map'
  );
  const seen = new Map<Element, number>();
  targets.forEach((el) => {
    const p = el.parentElement!;
    const i = seen.get(p) ?? 0;
    seen.set(p, i + 1);
    el.style.setProperty('--i', String(Math.min(i, 7)));
    el.classList.add('reveal');
  });
  document.querySelectorAll('.split').forEach((s) => {
    s.children[0]?.classList.add('from-left');
    s.children[1]?.classList.add('from-right');
  });
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add('in');
      io.unobserve(e.target);
    }),
    { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
  );
  targets.forEach((el) => io.observe(el));

  // ── count-up numbers ──
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  const co = new IntersectionObserver((entries) => entries.forEach((e) => {
    if (!e.isIntersecting) return;
    co.unobserve(e.target);
    const el = e.target as HTMLElement;
    const to = Number(el.dataset.count), from = Number(el.dataset.from ?? 0);
    if (reduce) { el.textContent = String(to); return; }
    const t0 = performance.now(), dur = 1400;
    const step = (t: number) => {
      const k = Math.min(1, (t - t0) / dur);
      el.textContent = String(Math.round(from + (to - from) * (1 - Math.pow(1 - k, 3))));
      if (k < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }), { threshold: 0.6 });
  counters.forEach((c) => co.observe(c));
</script>
